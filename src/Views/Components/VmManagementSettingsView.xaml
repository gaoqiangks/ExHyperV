<UserControl x:Class="ExHyperV.Views.VmManagementSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:services="clr-namespace:ExHyperV.Services"
             xmlns:properties="clr-namespace:ExHyperV.Properties">
    <UserControl.Resources>
        <Style x:Key="ManagementSection" TargetType="Border">
            <Setter Property="Background" Value="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ui:ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="ManagementHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="ManagementHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,12"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="24,20,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="{x:Static properties:VmManagementText.Title}" FontSize="20"/>
                <TextBlock Text="{x:Static properties:VmManagementText.ApplyHint}" Style="{StaticResource ManagementHint}" Margin="0,6,0,0"/>
            </StackPanel>
            <ui:Button Grid.Column="1" Command="{Binding GoToVmManagementSettingsCommand}" IsEnabled="{Binding CanReloadVmManagement}"
                       ToolTip="{x:Static properties:VmManagementText.Refresh}" Appearance="Transparent" Padding="8" Margin="0,0,4,0">
                <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="20"/>
            </ui:Button>
            <ui:Button Grid.Column="2" Command="{Binding GoBackToDashboardCommand}" Appearance="Transparent" Padding="8">
                <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="20"/>
            </ui:Button>
        </Grid>
        <ScrollViewer Grid.Row="1" Margin="24,0,24,24" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
            <StackPanel>
                <TextBlock Text="{x:Static properties:VmManagementText.Loading}" Style="{StaticResource ManagementHint}"
                           Visibility="{Binding IsLoadingVmManagement, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding ManagementError}" TextWrapping="Wrap" Foreground="#E55E5E" Margin="0,0,0,8"/>
                <StackPanel IsEnabled="{Binding CanEditVmManagement}">
                    <Border Style="{StaticResource ManagementSection}">
                        <StackPanel>
                            <TextBlock Text="{x:Static properties:VmManagementText.Name}" Style="{StaticResource ManagementHeading}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ManagementName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Margin="0,0,12,0" VerticalContentAlignment="Center"/>
                                <ui:Button Grid.Column="1" Content="{x:Static properties:VmManagementText.Apply}" Command="{Binding ApplyManagementNameCommand}" MinWidth="88"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ManagementSection}">
                        <StackPanel>
                            <TextBlock Text="{x:Static properties:VmManagementText.Integration}" Style="{StaticResource ManagementHeading}"/>
                            <TextBlock Text="{x:Static properties:VmManagementText.IntegrationHint}" Style="{StaticResource ManagementHint}"/>
                            <ItemsControl ItemsSource="{Binding ManagementIntegrationServices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled, Mode=TwoWay}" Margin="0,4,0,4"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Style.Triggers>
                                            <Trigger Property="HasItems" Value="False">
                                                <Setter Property="Template">
                                                    <Setter.Value><ControlTemplate><TextBlock Text="{x:Static properties:VmManagementText.IntegrationEmpty}" TextWrapping="Wrap" Opacity="0.7"/></ControlTemplate></Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                            </ItemsControl>
                            <ui:Button Content="{x:Static properties:VmManagementText.Apply}" Command="{Binding ApplyManagementIntegrationCommand}" HorizontalAlignment="Right" MinWidth="88" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ManagementSection}">
                        <StackPanel IsEnabled="{Binding CanEditManagementCheckpoints}">
                            <TextBlock Text="{x:Static properties:VmManagementText.Checkpoints}" Style="{StaticResource ManagementHeading}"/>
                            <TextBlock Text="{x:Static properties:VmManagementText.CheckpointHint}" Style="{StaticResource ManagementHint}"/>
                            <TextBlock Text="{x:Static properties:VmManagementText.CheckpointType}" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding ManagementCheckpointTypes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding ManagementCheckpointType, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                            <CheckBox Content="{x:Static properties:VmManagementText.AutomaticCheckpoints}" Margin="0,12,0,16"
                                      IsEnabled="{Binding CanEditManagementAutomaticCheckpoints}" IsChecked="{Binding ManagementAutomaticCheckpointsEnabled, Mode=TwoWay}"/>
                            <TextBlock Text="{x:Static properties:VmManagementText.CheckpointDirectory}" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ManagementCheckpointDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0" VerticalContentAlignment="Center"/>
                                <ui:Button Grid.Column="1" Content="{x:Static properties:VmManagementText.Browse}" Command="{Binding BrowseManagementCheckpointsCommand}" MinWidth="88"/>
                            </Grid>
                            <TextBlock Text="{x:Static properties:VmManagementText.CheckpointDirectoryHint}" Style="{StaticResource ManagementHint}"/>
                            <ui:Button Content="{x:Static properties:VmManagementText.Apply}" Command="{Binding ApplyManagementCheckpointsCommand}" HorizontalAlignment="Right" MinWidth="88"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ManagementSection}">
                        <StackPanel>
                            <TextBlock Text="{x:Static properties:VmManagementText.SmartPaging}" Style="{StaticResource ManagementHeading}"/>
                            <TextBlock Text="{x:Static properties:VmManagementText.SmartPagingHint}" Style="{StaticResource ManagementHint}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ManagementSmartPagingDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0" VerticalContentAlignment="Center"/>
                                <ui:Button Grid.Column="1" Content="{x:Static properties:VmManagementText.Browse}" Command="{Binding BrowseManagementSmartPagingCommand}" MinWidth="88"/>
                            </Grid>
                            <ui:Button Content="{x:Static properties:VmManagementText.Apply}" Command="{Binding ApplyManagementSmartPagingCommand}" HorizontalAlignment="Right" MinWidth="88" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ManagementSection}">
                        <StackPanel>
                            <TextBlock Text="{x:Static properties:VmManagementText.AutomaticStart}" Style="{StaticResource ManagementHeading}"/>
                            <TextBlock Text="{x:Static properties:VmManagementText.AutomaticStartHint}" Style="{StaticResource ManagementHint}"/>
                            <TextBlock Text="{x:Static services:HostStartupPolicyText.OverrideHint}" Style="{StaticResource ManagementHint}"/>
                            <ComboBox ItemsSource="{Binding ManagementStartActions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding ManagementStartAction, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                            <TextBlock Text="{x:Static properties:VmManagementText.StartDelay}" Margin="0,12,0,6"/>
                            <TextBox Text="{Binding ManagementStartDelay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditManagementStartDelay}"
                                     MinWidth="100" MaxWidth="180" HorizontalAlignment="Left"/>
                            <ui:Button Content="{x:Static properties:VmManagementText.Apply}" Command="{Binding ApplyManagementStartCommand}" HorizontalAlignment="Right" MinWidth="88" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ManagementSection}">
                        <StackPanel>
                            <TextBlock Text="{x:Static properties:VmManagementText.AutomaticStop}" Style="{StaticResource ManagementHeading}"/>
                            <TextBlock Text="{x:Static properties:VmManagementText.AutomaticStopHint}" Style="{StaticResource ManagementHint}"/>
                            <ComboBox ItemsSource="{Binding ManagementStopActions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding ManagementStopAction, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                            <TextBlock Text="{x:Static properties:VmManagementText.StopHint}" Style="{StaticResource ManagementHint}"/>
                            <ui:Button Content="{x:Static properties:VmManagementText.Apply}" Command="{Binding ApplyManagementStopCommand}" HorizontalAlignment="Right" MinWidth="88"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
