<ui:FluentWindow 
    xmlns:properties="clr-namespace:ExHyperV.Properties"
    x:Class="ExHyperV.Views.ConsoleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    
    xmlns:converters="clr-namespace:ExHyperV.Converters"
    xmlns:tools="clr-namespace:ExHyperV.Tools"
    xmlns:models="clr-namespace:ExHyperV.Models"
    Title="{Binding VmName}"
    MinWidth="600"
    MinHeight="340"
    Width="1100"
    Height="820"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica">

    <ui:FluentWindow.Resources>
    </ui:FluentWindow.Resources>

    <DockPanel x:Name="ConsoleLayout" LastChildFill="True" Background="Transparent">
        <!-- 全屏时，Visibility 会变为 Collapsed，释放顶部 42 像素空间 -->
        <ui:TitleBar x:Name="TopTitleBar"
            DockPanel.Dock="Top" 
            Height="42" 
            Padding="0"
            Visibility="{Binding IsFullScreen, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
            <ui:TitleBar.Header>
                <Grid x:Name="ToolbarRoot" Margin="12,0,0,0" HorizontalAlignment="Stretch"><!-- 不设 Background：空白区落到原生标题栏(NC)，由系统处理拖动/双击最大化 -->
                    <StackPanel x:Name="ConsoleToolbar" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="VmNameText" Text="{Binding VmName}"
           VerticalAlignment="Center"
           Margin="0,0,16,0"
           FontSize="12"
           FontWeight="SemiBold"
           MouseLeftButtonDown="OnHeaderMouseLeftButtonDown"
           Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/><!-- 文字会接住鼠标 → 显式 DragMove 才能拖窗口（穿透在 ui:TitleBar 里拖不动，对齐 1.4.3） -->

                        <Grid x:Name="PowerControls" VerticalAlignment="Center">
                            <!-- 启动按钮 -->
                            <ui:Button x:Name="StartButton" Icon="{ui:SymbolIcon Symbol=Play24}"
                               Appearance="Transparent" Background="Transparent"
                               Width="60" 
                               Height="32"
                               Padding="0"
                               Command="{Binding StartVmCommand}"
                               ToolTip="{x:Static properties:Resources.ConsoleWindow_StartVm}"
                               Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>

                            <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                <ui:Button Icon="{ui:SymbolIcon Symbol=Power24}"
                                   Appearance="Transparent" Background="Transparent"
                                   Width="36"
                                   Height="32"
                                   Padding="0"
                                   CornerRadius="4,0,0,4"
                                   Command="{Binding ShutdownVmCommand}"
                                   ToolTip="{x:Static properties:Resources.ConsoleWindow_ShutDown}" />

                                <ui:DropDownButton x:Name="PowerMenuButton" Appearance="Transparent" Background="Transparent"
                                           Width="24"
                                           Height="32"
                                           Padding="0,0,8,0"
                                           Margin="0"
                                           CornerRadius="0,4,4,0"
                                           HorizontalContentAlignment="Center"
                                           IsEnabled="{Binding IsNotBusy}">
                                    <ui:DropDownButton.Flyout>
                                        <ContextMenu>
                                            <MenuItem Header="{x:Static properties:Resources.ConsoleWindow_Restart}" Command="{Binding ResetVmCommand}">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="ArrowSync24"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{x:Static properties:Resources.ConsoleWindow_Pause}" Command="{Binding PauseVmCommand}">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Pause24"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{x:Static properties:Resources.ConsoleWindow_SaveState}" Command="{Binding SaveVmCommand}">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Save24"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="{x:Static properties:Resources.ConsoleWindow_TurnOff}" Foreground="#FF4D4F" Command="{Binding TurnOffVmCommand}">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Power24" Foreground="#FF4D4F"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </ui:DropDownButton.Flyout>
                                </ui:DropDownButton>

                            </StackPanel>
                        </Grid>

                        <ui:DropDownButton x:Name="ResolutionButton" Content="{Binding SelectedResolution}"
                                   Icon="{ui:SymbolIcon Symbol=Desktop24}" 
                                   Appearance="Transparent" Background="Transparent" 
                                   FontSize="16" 
                                   Height="32"
                                   Padding="8,0" 
                                   Margin="8,0,0,0"
                                   ToolTip="{x:Static properties:ConsoleSessionText.ResolutionHint}"
                                   ToolTipService.ShowOnDisabled="True"
                                   IsEnabled="{Binding CanChangeResolution}">
                            <ui:DropDownButton.Flyout>
                                <ContextMenu ItemsSource="{Binding Resolutions}">
                                    <ContextMenu.ItemContainerStyle>
                                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                            <Setter Property="Header" Value="{Binding}" />
                                            <Setter Property="Command" Value="{Binding DataContext.ChangeResolutionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Setter Property="CommandParameter" Value="{Binding}" />
                                        </Style>
                                    </ContextMenu.ItemContainerStyle>
                                </ContextMenu>
                            </ui:DropDownButton.Flyout>
                        </ui:DropDownButton>

                        <!-- Enhanced scaling changes the guest DPI, independently of bitmap zoom. -->
                        <ui:DropDownButton x:Name="DesktopScaleButton" Content="{Binding SelectedDesktopScaleLabel}"
                                           Icon="{ui:SymbolIcon Symbol=ZoomIn24}"
                                           Appearance="Transparent" Background="Transparent"
                                           FontSize="16" Height="32" Padding="8,0" Margin="8,0,0,0"
                                           ToolTip="{x:Static models:DesktopScaleText.Hint}"
                                           Visibility="{Binding CanChangeDesktopScale, Converter={StaticResource BoolToVis}}">
                            <ui:DropDownButton.Flyout>
                                <ContextMenu ItemsSource="{Binding DesktopScaleOptions}">
                                    <ContextMenu.ItemContainerStyle>
                                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                            <Setter Property="Header" Value="{Binding Label}" />
                                            <Setter Property="Command" Value="{Binding DataContext.ChangeDesktopScaleCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Setter Property="CommandParameter" Value="{Binding}" />
                                        </Style>
                                    </ContextMenu.ItemContainerStyle>
                                </ContextMenu>
                            </ui:DropDownButton.Flyout>
                        </ui:DropDownButton>

                        <!-- Basic-session zoom stretches the framebuffer. -->
                        <ui:DropDownButton x:Name="ZoomButton" Content="{Binding SelectedZoom}"
                                   Icon="{ui:SymbolIcon Symbol=ZoomIn24}"
                                   Appearance="Transparent" Background="Transparent"
                                   FontSize="16"
                                   Height="32"
                                   Padding="8,0"
                                   Margin="8,0,0,0"
                                   ToolTip="{x:Static properties:Resources.ConsoleWindow_ZoomHint}"
                                   Visibility="{Binding IsEnhancedMode, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                            <ui:DropDownButton.Flyout>
                                <ContextMenu ItemsSource="{Binding ZoomOptions}">
                                    <ContextMenu.ItemContainerStyle>
                                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                            <Setter Property="Header" Value="{Binding}" />
                                            <Setter Property="Command" Value="{Binding DataContext.ChangeZoomCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Setter Property="CommandParameter" Value="{Binding}" />
                                        </Style>
                                    </ContextMenu.ItemContainerStyle>
                                </ContextMenu>
                            </ui:DropDownButton.Flyout>
                        </ui:DropDownButton>

                        <ui:DropDownButton x:Name="SessionModeButton" Content="{Binding SelectedSessionMode}"
                           Appearance="Transparent" Background="Transparent" 
                           FontSize="16"
                           Height="32"
                           Padding="8,0"
                           ToolTip="{x:Static properties:ConsoleSessionText.ModeHint}"
                           Margin="8,0,0,0">
                            <ui:DropDownButton.Flyout>
                                <ContextMenu>
                                    <MenuItem Header="{x:Static properties:Resources.ConsoleViewModel_BasicSession}" Command="{Binding SwitchSessionModeCommand}" CommandParameter="{x:Static properties:Resources.ConsoleViewModel_BasicSession}" />
                                    <MenuItem Header="{x:Static properties:Resources.ConsoleViewModel_EnhancedSession}" Command="{Binding SwitchSessionModeCommand}" CommandParameter="{x:Static properties:Resources.ConsoleViewModel_EnhancedSession}" IsEnabled="{Binding IsEnhancedAvailable}" />
                                </ContextMenu>
                            </ui:DropDownButton.Flyout>
                        </ui:DropDownButton>

                        <!-- CAD 按钮仅基本会话显示：增强会话是 RDP，SAS 无法程序化发送(系统 mstscax 拒绝)，与微软 VMConnect 一致 → 隐藏 -->
                        <ui:Button Appearance="Transparent" Background="Transparent"
                                   Width="38"
                                   Height="32"
                                   Padding="0"
                                   Margin="8,0,0,0"
                                   Command="{Binding SendCadCommand}"
                                   ToolTip="{x:Static properties:Resources.ConsoleWindow_SendCtrlAltDel}"
                                   Visibility="{Binding IsEnhancedMode, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                            <ui:SymbolIcon Symbol="Keyboard24" FontSize="16" />
                        </ui:Button>

                        
                        <!-- 全屏切换按钮 -->
                        <ui:Button Icon="{ui:SymbolIcon Symbol=FullScreenMaximize24}"
                                   Appearance="Transparent" Background="Transparent"
                                   Height="32"
                                   Padding="8,0"
                                   Margin="8,0,0,0"
                                   Command="{Binding ToggleFullScreenCommand}"
                                   ToolTip="{x:Static properties:Resources.ConsoleWindow_FullScreen}" />
                    </StackPanel>
                </Grid>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Window controls remain visible while the session toolbar can scroll in short windows. -->
        <Border x:Name="SideBar" DockPanel.Dock="Left" Width="68" Visibility="Collapsed"
                Background="{ui:ThemeResource ApplicationBackgroundBrush}"
                BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <Border x:Name="ToolbarDragHandle" DockPanel.Dock="Top" Height="20" Margin="7,4,7,0"
                        Background="Transparent" Cursor="SizeAll" ToolTip="拖动窗口，双击最大化 / 还原">
                    <TextBlock Text="&#xE784;" FontFamily="Segoe Fluent Icons" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel x:Name="SideWindowButtons" DockPanel.Dock="Bottom" Margin="7,4,7,8">
                    <ui:Button Content="&#xE921;" FontFamily="Segoe Fluent Icons" FontSize="12"
                               Width="52" Height="36" Margin="0,2" Padding="0" Appearance="Transparent"
                               ToolTip="最小化" AutomationProperties.Name="最小化"
                               Click="OnMinimizeClick"/>
                    <ui:Button x:Name="SideMaximizeButton" Content="&#xE922;" FontFamily="Segoe Fluent Icons" FontSize="12"
                               Width="52" Height="36" Margin="0,2" Padding="0" Appearance="Transparent"
                               ToolTip="最大化 / 还原" AutomationProperties.Name="最大化 / 还原"
                               Click="OnMaximizeClick"/>
                    <ui:Button Content="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="12"
                               Width="52" Height="36" Margin="0,2" Padding="0" Appearance="Transparent"
                               ToolTip="关闭连接窗口" AutomationProperties.Name="关闭连接窗口"
                               Click="OnCloseClick"/>
                </StackPanel>
                <ScrollViewer x:Name="ToolbarScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <ContentControl x:Name="SideToolbarHost" Margin="7,8,7,0"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- RDP 画面按虚拟机尺寸居中；连接遮罩由 RdpClientHost 的 WinForms 层提供。 -->
        <Grid x:Name="RdpArea" Background="#FF000000">
            <tools:RdpClientHost x:Name="RdpHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </Grid>
    </DockPanel>
</ui:FluentWindow>
